{
  "id": "/",
  "name": "Chrisphics Hub — CRISPprint Ghana",
  "short_name": "Chrisphics",
  "description": "Chrisphics Hub keeps the printing jobs, clients and accounts of CRISPprint Ghana.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window_controls", "browser"],
  "background_color": "#1c1517",
  "theme_color": "#1c1517",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New job",
      "short_name": "New job",
      "url": "/?action=new-job#/jobs",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Receive payment",
      "short_name": "Receive",
      "url": "/?action=receive-payment#/accounts",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Who owes",
      "short_name": "Owed",
      "url": "/#/accounts",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
