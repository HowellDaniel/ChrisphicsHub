.DS_Store
**/.DS_Store
__pycache__/
*.pyc
.pytest_cache/

# The app bundle under the old misspelled name. The shop is still running from it;
# it is deleted once "Chrisphics Hub.app" replaces it. Never rebuild or publish this one.
Chriphics Hub.app/

# Two one-off scripts that settled the shop's own ledger: they name clients and their money,
# and this repository is public. Keep them on the Mac, never in it.
tools/clear-owed-on-jobs.sql
tools/write-off-152-profit.sql

# Portable bundles and the interpreter archives they are built from. Both are products of
# `tools/build-installer.py`, both are hundreds of megabytes, and the archives are re-downloadable:
# they belong on the machine that receives them, not in the repository that built them.
# `dist*` also covers the second folder a `CHRISPHICS_DIST=… --blank` demo build writes beside it.
dist*/
runtime-cache/
